# Local .terraform directory
.terraform/
.terraform.lock.hcl

# Terraform state — never commit state files
*.tfstate
*.tfstate.*
*.tfstate.backup

# Terraform plan output
*.tfplan

# Crash log files
crash.log
crash.*.log

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI config
.terraformrc
terraform.rc

# Sensitive variable files
*.tfvars
*.tfvars.json
!example.tfvars
