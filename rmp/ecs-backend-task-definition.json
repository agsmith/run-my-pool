{
  "family": "runmypool-backend",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "arn:aws:iam::739444271939:role/ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::739444271939:role/ecsTaskRole",
  "containerDefinitions": [
    {
      "name": "backend",
      "image": "739444271939.dkr.ecr.us-east-1.amazonaws.com/runmypool-backend:latest",
      "portMappings": [
        {
          "name": "backend-port",
          "containerPort": 8000,
          "protocol": "tcp",
          "appProtocol": "http"
        }
      ],
      "essential": true,
      "environment": [
        {
          "name": "CORS_ORIGINS",
          "value": "https://your-frontend-domain.com"
        }
      ],
      "secrets": [
        {
          "name": "DATABASE_URL",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:739444271939:secret:runmypool/database-url"
        },
        {
          "name": "JWT_SECRET",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:739444271939:secret:runmypool/jwt-secret"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/runmypool-backend",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "ecs"
        }
      },
      "healthCheck": {
        "command": [
          "CMD-SHELL",
          "curl -f http://localhost:8000/ || exit 1"
        ],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 60
      }
    }
  ]
}
