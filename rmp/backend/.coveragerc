[run]
source = .
omit =
    # One-off scripts — not application code
    create_schema.py
    db_init.py
    fix_duplicate_constraints.py
    leagues.py
    migrate_teams.py
    parse_schedule.py
    picks_new.py
    seed_schedule.py
    # Test files themselves
    tests/*
    # Virtualenv
    venv/*

[report]
exclude_lines =
    pragma: no cover
    def __repr__
    if __name__ == .__main__.:
    raise NotImplementedError
